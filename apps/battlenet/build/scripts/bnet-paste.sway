# Wolf types pasted text as Ctrl+Shift+U, hex digits, release (keycodes are evdev+8)
bindcode --no-repeat Control+Shift+30 mode "bnet-unicode", exec /tmp/bnet-paste.sh start
mode "bnet-unicode" {
    bindcode --no-repeat Control+Shift+19 exec /tmp/bnet-paste.sh key 0
    bindcode --no-repeat Control+Shift+10 exec /tmp/bnet-paste.sh key 1
    bindcode --no-repeat Control+Shift+11 exec /tmp/bnet-paste.sh key 2
    bindcode --no-repeat Control+Shift+12 exec /tmp/bnet-paste.sh key 3
    bindcode --no-repeat Control+Shift+13 exec /tmp/bnet-paste.sh key 4
    bindcode --no-repeat Control+Shift+14 exec /tmp/bnet-paste.sh key 5
    bindcode --no-repeat Control+Shift+15 exec /tmp/bnet-paste.sh key 6
    bindcode --no-repeat Control+Shift+16 exec /tmp/bnet-paste.sh key 7
    bindcode --no-repeat Control+Shift+17 exec /tmp/bnet-paste.sh key 8
    bindcode --no-repeat Control+Shift+18 exec /tmp/bnet-paste.sh key 9
    bindcode --no-repeat Control+Shift+38 exec /tmp/bnet-paste.sh key a
    bindcode --no-repeat Control+Shift+56 exec /tmp/bnet-paste.sh key b
    bindcode --no-repeat Control+Shift+54 exec /tmp/bnet-paste.sh key c
    bindcode --no-repeat Control+Shift+40 exec /tmp/bnet-paste.sh key d
    bindcode --no-repeat Control+Shift+26 exec /tmp/bnet-paste.sh key e
    bindcode --no-repeat Control+Shift+41 exec /tmp/bnet-paste.sh key f
    bindsym --release Shift_L mode "default", exec /tmp/bnet-paste.sh end
    bindsym --release Control_L mode "default", exec /tmp/bnet-paste.sh end
}
