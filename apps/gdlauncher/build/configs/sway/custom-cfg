# Managed by the GDLauncher image: rewritten into ~/.config/sway on every start (included by the base sway config).
# Mod1 is Alt. NOTE: this file is included at the TOP of the base sway config, before `set $mod` is defined, so the
# literal Mod1 must be used here, not $mod. Close: Alt+F4 / Alt+Shift+Q (base config). Alt + middle click closes a window.
bindsym Mod1+f fullscreen toggle
bindsym Mod1+Shift+space floating toggle
bindsym --whole-window Mod1+button2 kill
# Dialogs and pop-ups float instead of being squeezed into the tiled layout
for_window [window_type="dialog"] floating enable
for_window [window_type="utility"] floating enable
for_window [window_type="splash"] floating enable
for_window [window_role="pop-up"] floating enable
