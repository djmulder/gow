// -*- mode: jsonc -*-
// Managed by the GDLauncher image: rewritten into ~/.config/waybar on every start.
// Adds a taskbar (click = focus, middle-click = close) and Float / Max / Close buttons that act on the focused window.
{
  "layer": "top",
  "position": "top",
  "height": 30,
  "spacing": 4,
  "modules-left": [
    "sway/workspaces",
    "wlr/taskbar"
  ],
  "modules-center": [
    "sway/window"
  ],
  "modules-right": [
    "custom/float",
    "custom/max",
    "custom/close",
    "pulseaudio",
    "custom/clock"
  ],
  "wlr/taskbar": {
    "format": "{icon} {title:.22}",
    "icon-size": 16,
    "tooltip-format": "{title}",
    "on-click": "activate",
    "on-click-middle": "close"
  },
  "sway/window": {
    "max-length": 50
  },
  "custom/float": {
    "format": " Float",
    "tooltip-format": "Floating window you can move and resize",
    "on-click": "swaymsg 'fullscreen disable; floating enable'"
  },
  "custom/max": {
    "format": " Max",
    "tooltip-format": "Maximize: every window fills the screen below the bar, switch with the taskbar or tabs",
    "on-click": "swaymsg 'fullscreen disable; floating disable; layout tabbed'"
  },
  "custom/close": {
    "format": " Close",
    "tooltip-format": "Close the focused window",
    "on-click": "swaymsg kill"
  },
  "custom/clock": {
    "format": "  {}",
    "tooltip": false,
    "interval": 60,
    "exec": "date +'%d %a %H:%M'"
  },
  "pulseaudio": {
    "format": "{volume}% {icon}",
    "format-muted": "muted",
    "format-icons": {
      "default": ["", "", ""]
    }
  }
}
